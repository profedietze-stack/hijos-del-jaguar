    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.2.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "howler": "^2.2.4",
    "topojson-client": "^3.1.0"
